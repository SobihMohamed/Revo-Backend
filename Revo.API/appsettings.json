{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "LuckyPennySoftware": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/revo-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=Revo_Database;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Redis": "127.0.0.1:6379,connectTimeout=1000,syncTimeout=1000,abortConnect=false"
  },
  "CloudinarySettings": {
    "CloudName": "dfvix8iwc",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "SiteSettings": {
    "WhatsAppAdminNumber": "+201XXXXXXXXX"
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "WhatsAppNumber": "",
    "AdminPhoneNumber": ""
  },
  "JwtTokenSettings": {
    "SecretKey": "dQ971FeJWVUkdPSFZl5wSMmYc0zNKSanHVtuWxfgAWL",
    "Issuer": "RevoAPI",
    "Audience": "RevoDashboardAdmins"
  }
}